# Copy to .env for local development. Do not commit real values.
SLACK_BOT_TOKEN=<slack-bot-token>
SLACK_APP_TOKEN=<slack-app-token>
KAGENT_BOT_USER_ID=<slack-bot-user-id>
ALLOWED_CHANNEL_IDS=<slack-alert-channel-id>
TRUSTED_DATADOG_SENDER_IDS=
KAGENT_BASE_URL=http://kagent-controller.kagent:8083
KAGENT_API_TOKEN=unused-in-local-unsecure-mode
KAGENT_NAMESPACE=kagent
KAGENT_AGENT_NAME=datadog-agent
KAGENT_USER_ID=admin@kagent.dev
KAGENT_REQUEST_TIMEOUT_SECONDS=120
KAGENT_SESSION_POLL_TIMEOUT_SECONDS=90
KAGENT_SESSION_POLL_INTERVAL_SECONDS=2
DEDUPE_TTL_SECONDS=3600
LOG_LEVEL=INFO
